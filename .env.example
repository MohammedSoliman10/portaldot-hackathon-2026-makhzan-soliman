# Copy to .env and fill in locally. Never commit .env.
# The keygen task writes this file with mode 600 and refuses to overwrite it.

# Portaldot network
PORTALDOT_EVM_RPC_URL=
PORTALDOT_WS_URL=
PORTALDOT_EXPLORER_URL=

# Burner keys: test funds only. Generated by `npm run keygen`.
PROVIDER_1_KEY=
PROVIDER_2_KEY=
PROVIDER_3_KEY=
PROVIDER_4_KEY=
VAULT_AGENT_KEY=
OWNER_KEY=
