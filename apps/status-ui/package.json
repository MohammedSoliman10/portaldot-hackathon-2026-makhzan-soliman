{
  "name": "status-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --project browser",
    "check:evidence": "node scripts/check-evidence.mjs",
    "check:sample": "node scripts/check-sample.mjs",
    "check:readonly": "vitest run test/readonly-guard.test.ts",
    "smoke": "node scripts/smoke-routes.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@tailwindcss/vite": "^4.1.14",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.1.14",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
