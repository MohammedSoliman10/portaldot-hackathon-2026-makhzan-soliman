# Public build-time configuration. Copy to .env.local for a live build; never commit values.
# None of these is a secret. The app has no key, wallet or write path.

# RECORDED | LOCAL | LIVE. Unset means RECORDED unless an address is also set.
VITE_MAKHZAN_MODE=

# HTTP JSON-RPC endpoint. Required by LOCAL and LIVE.
VITE_MAKHZAN_RPC_URL=

# Expected chain id; defaults to 420420777 when empty.
VITE_MAKHZAN_CHAIN_ID=

# Deployment address a judge may read. Never a signer.
VITE_MAKHZAN_CONTRACT_ADDRESS=

# Optional StorageGate deployment address on the same chain.
VITE_GATE_ADDRESS=
